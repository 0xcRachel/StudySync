# Backend StudySync
# Sao chép file này thành backend/.env rồi sửa nếu cần.
# Mặc định không có .env vẫn chạy được với SQLite.

APP_ENV=development

# sqlite (mặc định, không cần cài thêm) hoặc mysql
DB_DRIVER=sqlite

# Đường dẫn file SQLite. Bỏ trống để dùng backend/data/studysync.sqlite
# DB_SQLITE_PATH=

# Cấu hình MySQL (chỉ dùng khi DB_DRIVER=mysql)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=studysync
# DB_USER=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4

# Gateway WebSocket real-time (npm run api tự khởi động cùng PHP API).
REALTIME_PORT=8090

# * khi phát triển; production nên đặt danh sách origin cụ thể.
CORS_ALLOWED_ORIGINS=*

# Tạo 3 công việc mẫu khi database trống.
SEED_DEMO_DATA=false

# OAuth đăng nhập (tạo app OAuth riêng ở Google Cloud Console và Meta for Developers).
# Khai báo Redirect URI chính xác là http://localhost:8080/oauth_callback.php?provider=google
# và http://localhost:8080/oauth_callback.php?provider=facebook trong từng app.
OAUTH_APP_URL=http://localhost:19006
OAUTH_CALLBACK_URL=http://localhost:8080/oauth_callback.php
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v25.0
