# URL gốc của PHP API, không có dấu / ở cuối.
#
# Chạy backend bằng "npm run api" (PHP built-in server, cổng 8080):
#   Android Emulator: http://10.0.2.2:8080
#   iOS Simulator:    http://localhost:8080
#   Expo Web:         http://localhost:8080
#   Điện thoại thật:  http://<IP_LAN_MAY_CHAY_PHP>:8080
#
# Nếu dùng XAMPP và copy backend vào htdocs/studysync_api:
#   http://<IP_LAN_MAY_CHAY_PHP>/studysync_api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# WebSocket real-time mặc định là ws://<host>:8090.
# EXPO_PUBLIC_REALTIME_URL=ws://192.168.1.20:8090

# Thời gian chờ tối đa cho mỗi request (ms)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# json (mặc định) hoặc form. Backend trong repo hỗ trợ cả hai;
# chỉ đổi sang form khi phải gọi backend cũ chỉ đọc $_POST.
EXPO_PUBLIC_API_REQUEST_FORMAT=json
